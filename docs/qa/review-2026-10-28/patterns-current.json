\"fontWeight\":\"600\",\"letterSpacing\":\"0.1em\",\"textTransform\":\"uppercase\"},\"elements\":{\"link\":{\"color\":{\"text\":\"var:preset|color|muted-2\"},\"typography\":{\"textDecoration\":\"none\"}}}},\"textColor\":\"muted-2\",\"fontSize\":\"x-small\"} /-->\n\n\t\t\t\t\t\t<!-- wp:post-date {\"isLink\":true,\"style\":{\"typography\":{\"fontWeight\":\"600\",\"letterSpacing\":\"0.1em\",\"textTransform\":\"uppercase\"}},\"textColor\":\"muted-2\",\"fontSize\":\"x-small\"} /-->\n\t\t\t\t\t</div>\n\t\t\t\t\t<!-- /wp:group -->\n\n\t\t\t\t\t<!-- wp:post-title {\"isLink\":true,\"style\":{\"typography\":{\"fontSize\":\"28px\",\"lineHeight\":\"1.2\"}}} /-->\n\n\t\t\t\t\t<!-- wp:post-excerpt {\"excerptLength\":25,\"style\":{\"typography\":{\"fontSize\":\"15px\",\"lineHeight\":\"1.55\"}},\"textColor\":\"muted\"} /-->\n\t\t\t\t</div>\n\t\t\t\t<!-- /wp:group -->\n\t\t\t</div>\n\t\t\t<!-- /wp:group -->\n\t\t<!-- /wp:post-template -->\n\n\t\t<!-- wp:query-pagination {\"paginationArrow\":\"arrow\",\"className\":\"wl-pagination\",\"style\":{\"spacing\":{\"margin\":{\"top\":\"var:preset|spacing|50\"}}},\"layout\":{\"type\":\"flex\",\"justifyContent\":\"center\"}} -->\n\t\t\t<!-- wp:query-pagination-previous /-->\n\n\t\t\t<!-- wp:query-pagination-numbers /-->\n\n\t\t\t<!-- wp:query-pagination-next /-->\n\t\t<!-- /wp:query-pagination -->\n\n\t\t<!-- wp:query-no-results -->\n\t\t\t<!-- wp:pattern {\"slug\":\"wild-lemon/hidden-no-results\"} /-->\n\t\t<!-- /wp:query-no-results -->\n\t</div>\n\t<!-- /wp:query -->\n</div>\n<!-- /wp:group -->\n"
