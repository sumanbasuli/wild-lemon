    {
        "name": "wild-lemon/seasonal-table",
        "content": "<!-- wp:group {\"align\":\"wide\",\"className\":\"wl-pattern-table\",\"layout\":{\"type\":\"default\"}} -->\n<div class=\"wp-block-group alignwide wl-pattern-table\">\n\t<!-- wp:columns {\"verticalAlignment\":\"center\",\"className\":\"wl-table-layout\"} -->\n\t<div class=\"wp-block-columns are-vertically-aligned-center wl-table-layout\">\n\t\t<!-- wp:column {\"verticalAlignment\":\"center\"} -->\n\t\t<div class=\"wp-block-column is-vertically-aligned-center\">\n\t\t\t<!-- wp:image {\"aspectRatio\":\"4/5\",\"scale\":\"cover\",\"sizeSlug\":\"full\",\"linkDestination\":\"none\",\"className\":\"wl-table-image\"} -->\n\t\t\t<figure class=\"wp-block-image size-full wl-table-image\"><img src=\"http://localhost:8089/wp-content/themes/wild-lemon/assets/images/seasonal-table.webp\" alt=\"Roasted vegetables, olives, and sourdough on a linen-covered table.\" style=\"aspect-ratio:4/5;object-fit:cover\"/></figure>\n\t\t\t<!-- /wp:image -->\n\t\t</div>\n\t\t<!-- /wp:column -->\n\t\t<!-- wp:column {\"verticalAlignment\":\"center\",\"className\":\"wl-table-copy\"} -->\n\t\t<div class=\"wp-block-column is-vertically-aligned-center wl-table-copy\">\n\t\t\t<!-- wp:paragraph {\"className\":\"wl-pattern-kicker\"} -->\n\t\t\t<p class=\"wl-pattern-kicker\">At the table</p>\n\t\t\t<!-- /wp:paragraph -->\n\t\t\t<!-- wp:heading {\"className\":\"wl-pattern-feature-title\"} -->\n\t\t\t<h2 class=\"wp-block-heading wl-pattern-feature-title\">Good things, in season.</h2>\n\t\t\t<!-- /wp:heading -->\n\t\t\t<!-- wp:paragraph {\"className\":\"wl-pattern-lede\"} -->\n\t\t\t<p class=\"wl-pattern-lede\">Something from the garden, a loaf still warm, and a little time to sit together. A good lunch can be that simple.</p>\n\t\t\t<!-- /wp:paragraph -->\n\t\t\t<!-- wp:columns {\"className\":\"wl-table-notes\"} -->\n\t\t\t<div class=\"wp-block-columns wl-table-notes\">\n\t\t\t\t<!-- wp:column -->\n\t\t\t\t<div class=\"wp-block-column\">\n\t\t\t\t\t<!-- wp:heading {\"level\":3} -->\n\t\t\t\t\t<h3 class=\"wp-block-heading\">Keep it seasonal</h3>\n\t\t\t\t\t<!-- /wp:heading -->\n\t\t\t\t\t<!-- wp:paragraph -->\n\t\t\t\t\t<p>Start with what looks best at the market. Let the rest follow.</p>\n\t\t\t\t\t<!-- /wp:paragraph -->\n\t\t\t\t</div>\n\t\t\t\t<!-- /wp:column -->\n\t\t\t\t<!-- wp:column -->\n\t\t\t\t<div class=\"wp-block-column\">\n\t\t\t\t\t<!-- wp:heading {\"level\":3} -->\n\t\t\t\t\t<h3 class=\"wp-block-heading\">Leave room</h3>\n\t\t\t\t\t<!-- /wp:heading -->\n\t\t\t\t\t<!-- wp:paragraph -->\n\t\t\t\t\t<p>For another chair, a second helping, and an unhurried afternoon.</p>\n\t\t\t\t\t<!-- /wp:paragraph -->\n\t\t\t\t</div>\n\t\t\t\t<!-- /wp:column -->\n\t\t\t</div>\n\t\t\t<!-- /wp:columns -->\n\t\t</div>\n\t\t<!-- /wp:column -->\n\t</div>\n\t<!-- /wp:columns -->\n</div>\n<!-- /wp:group -->\n"
    },
    {
        "name": "wild-lemon/slow-weekend",
        "content": "<!-- wp:group {\"align\":\"wide\",\"className\":\"wl-pattern-weekend\",\"layout\":{\"type\":\"default\"}} -->\n<div class=\"wp-block-group alignwide wl-pattern-weekend\">\n\t<!-- wp:columns {\"className\":\"wl-weekend-layout\"} -->\n\t<div class=\"wp-block-columns wl-weekend-layout\">\n\t\t<!-- wp:column {\"width\":\"40%\"} -->\n\t\t<div class=\"wp-block-column\" style=\"flex-basis:40%\">\n\t\t\t<!-- wp:paragraph {\"className\":\"wl-pattern-kicker\"} -->\n\t\t\t<p class=\"wl-pattern-kicker\">A little room to breathe</p>\n\t\t\t<!-- /wp:paragraph -->\n\t\t\t<!-- wp:heading {\"className\":\"wl-pattern-feature-title\"} -->\n\t\t\t<h2 class=\"wp-block-heading wl-pattern-feature-title\">Make a little less of a plan.</h2>\n\t\t\t<!-- /wp:heading -->\n\t\t\t<!-- wp:paragraph {\"className\":\"wl-pattern-lede\"} -->\n\t\t\t<p class=\"wl-pattern-lede\">A few gentle starting points for a weekend that feels like your own.</p>\n\t\t\t<!-- /wp:paragraph -->\n\t\t</div>\n\t\t<!-- /wp:column -->\n\t\t<!-- wp:column {\"width\":\"60%\",\"className\":\"wl-weekend-notes\"} -->\n\t\t<div class=\"wp-block-column wl-weekend-notes\" style=\"flex-basis:60%\">\n\t\t\t<!-- wp:details {\"showContent\":true,\"className\":\"wl-weekend-detail\"} -->\n\t\t\t<details class=\"wp-block-details wl-weekend-detail\" open><summary>Bring something fresh home</summary>\n\t\t\t\t<!-- wp:paragraph -->\n\t\t\t\t<p>Visit the market with one bag and an open mind. A bunch of herbs or a handful of ripe fruit is enough to begin with.</p>\n\t\t\t\t<!-- /wp:paragraph -->\n\t\t\t</details>\n\t\t\t<!-- /wp:details -->\n\t\t\t<!-- wp:details {\"className\":\"wl-weekend-detail\"} -->\n\t\t\t<details class=\"wp-block-details wl-weekend-detail\"><summary>Spend an hour outside</summary>\n\t\t\t\t<!-- wp:paragraph -->\n\t\t\t\t<p>Find a patch of sunlight, follow a familiar path, or sit under a tree. Leave the headphones behind and see what you notice.</p>\n\t\t\t\t<!-- /wp:paragraph -->\n\t\t\t</details>\n\t\t\t<!-- /wp:details -->\n\t\t\t<!-- wp:details {\"className\":\"wl-weekend-detail\"} -->\n\t\t\t<details class=\"wp-block-details wl-weekend-detail\"><summary>Save one small memory</summary>\n\t\t\t\t<!-- wp:paragraph -->\n\t\t\t\t<p>Write a sentence, take a photograph, or press a leaf between pages. Keep something that brings the day back to you.</p>\n\t\t\t\t<!-- /wp:paragraph -->\n\t\t\t</details>\n\t\t\t<!-- /wp:details -->\n\t\t</div>\n\t\t<!-- /wp:column -->\n\t</div>\n\t<!-- /wp:columns -->\n</div>\n<!-- /wp:group -->\n"
    },
    {
        "name": "wild-lemon/two-column-notes",
        "content": "<!-- wp:group {\"align\":\"wide\",\"className\":\"wl-pattern-notes\",\"layout\":{\"type\":\"default\"}} -->\n<div class=\"wp-block-group alignwide wl-pattern-notes\">\n\t<!-- wp:group {\"className\":\"wl-notes-heading\",\"layout\":{\"type\":\"default\"}} -->\n\t<div class=\"wp-block-group wl-notes-heading\">\n\t\t<!-- wp:paragraph {\"className\":\"wl-pattern-kicker\"} -->\n\t\t<p class=\"wl-pattern-kicker\">From the notebook</p>\n\t\t<!-- /wp:paragraph -->\n\t\t<!-- wp:heading -->\n\t\t<h2 class=\"wp-block-heading\">Small rituals. Rich days.</h2>\n\t\t<!-- /wp:heading -->\n\t</div>\n\t<!-- /wp:group -->\n\t<!-- wp:columns {\"className\":\"wl-pattern-note-columns\"} -->\n\t<div class=\"wp-block-columns wl-pattern-note-columns\">\n\t\t<!-- wp:column -->\n\t\t<div class=\"wp-block-column\">\n\t\t\t<!-- wp:paragraph {\"className\":\"wl-note-number\"} -->\n\t\t\t<p class=\"wl-note-number\">01</p>\n\t\t\t<!-- /wp:paragraph -->\n\t\t\t<!-- wp:heading {\"level\":3} -->\n\t\t\t<h3 class=\"wp-block-heading\">Follow your curiosity</h3>\n\t\t\t<!-- /wp:heading -->\n\t\t\t<!-- wp:paragraph -->\n\t\t\t<p>Take the long way home. Stop at the market. Leave a little room in the day for something you did not plan.</p>\n\t\t\t<!-- /wp:paragraph -->\n\t\t</div>\n\t\t<!-- /wp:column -->\n\t\t<!-- wp:column -->\n\t\t<div class=\"wp-block-column\">\n\t\t\t<!-- wp:paragraph {\"className\":\"wl-note-number\"} -->\n\t\t\t<p class=\"wl-note-number\">02</p>\n\t\t\t<!-- /wp:paragraph -->\n\t\t\t<!-- wp:heading {\"level\":3} -->\n\t\t\t<h3 class=\"wp-block-heading\">Make something to share</h3>\n\t\t\t<!-- /wp:heading -->\n\t\t\t<!-- wp:paragraph -->\n\t\t\t<p>A meal, a story, a handful of flowers. The ordinary things become memorable when we offer them to someone else.</p>\n\t\t\t<!-- /wp:paragraph -->\n\t\t</div>\n\t\t<!-- /wp:column -->\n\t</div>\n\t<!-- /wp:columns -->\n</div>\n<!-- /wp:group -->\n"
    }
]
