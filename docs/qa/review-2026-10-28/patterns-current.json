    {
        "name": "wild-lemon/footer",
        "content": "<!-- wp:group {\"align\":\"full\",\"className\":\"wl-footer\",\"style\":{\"spacing\":{\"padding\":{\"top\":\"var:preset|spacing|60\",\"right\":\"var:preset|spacing|60\",\"bottom\":\"var:preset|spacing|60\",\"left\":\"var:preset|spacing|60\"},\"blockGap\":\"var:preset|spacing|50\"},\"elements\":{\"link\":{\"color\":{\"text\":\"#DDD7C9\"}}}},\"backgroundColor\":\"contrast\",\"textColor\":\"base\",\"layout\":{\"type\":\"constrained\"}} -->\n<div class=\"wp-block-group alignfull wl-footer has-base-color has-contrast-background-color has-text-color has-background has-link-color\" style=\"padding-top:var(--wp--preset--spacing--60);padding-right:var(--wp--preset--spacing--60);padding-bottom:var(--wp--preset--spacing--60);padding-left:var(--wp--preset--spacing--60)\">\n\t<!-- wp:group {\"align\":\"wide\",\"className\":\"wl-footer-main\",\"style\":{\"spacing\":{\"blockGap\":\"var:preset|spacing|60\"}},\"layout\":{\"type\":\"grid\",\"columnCount\":2}} -->\n\t<div class=\"wp-block-group alignwide wl-footer-main\">\n\t\t<!-- wp:group {\"className\":\"wl-footer-brand\",\"style\":{\"spacing\":{\"blockGap\":\"14px\"}},\"layout\":{\"type\":\"default\"}} -->\n\t\t<div class=\"wp-block-group wl-footer-brand\">\n\t\t\t<!-- wp:site-title {\"level\":0,\"className\":\"wl-logo\",\"style\":{\"typography\":{\"fontSize\":\"26px\"}}} /-->\n\n\t\t\t<!-- wp:site-tagline {\"style\":{\"color\":{\"text\":\"#B5AE9E\"},\"typography\":{\"lineHeight\":\"1.6\"}},\"fontSize\":\"small\"} /-->\n\t\t</div>\n\t\t<!-- /wp:group -->\n\n\t\t<!-- wp:group {\"className\":\"wl-footer-links\",\"layout\":{\"type\":\"grid\",\"columnCount\":2}} -->\n\t\t<div class=\"wp-block-group wl-footer-links\">\n\t\t\t<!-- wp:group {\"className\":\"wl-footer-column\",\"style\":{\"spacing\":{\"blockGap\":\"12px\"}},\"layout\":{\"type\":\"default\"}} -->\n\t\t\t<div class=\"wp-block-group wl-footer-column\">\n\t\t\t\t<!-- wp:heading {\"style\":{\"color\":{\"text\":\"#B5AE9E\"},\"typography\":{\"fontWeight\":\"600\",\"letterSpacing\":\"0.12em\",\"lineHeight\":\"1.5\",\"textTransform\":\"uppercase\"}},\"fontSize\":\"x-small\",\"fontFamily\":\"schibsted-grotesk\"} -->\n\t\t\t\t<h2 class=\"wp-block-heading has-text-color has-schibsted-grotesk-font-family has-x-small-font-size\" style=\"color:#B5AE9E;font-weight:600;letter-spacing:0.12em;line-height:1.5;text-transform:uppercase\">Read</h2>\n\t\t\t\t<!-- /wp:heading -->\n\n\t\t\t\t<!-- wp:categories {\"showHierarchy\":false,\"showPostCounts\":false,\"className\":\"wl-footer-list\"} /-->\n\t\t\t</div>\n\t\t\t<!-- /wp:group -->\n\n\t\t\t<!-- wp:group {\"className\":\"wl-footer-column\",\"style\":{\"spacing\":{\"blockGap\":\"12px\"}},\"layout\":{\"type\":\"default\"}} -->\n\t\t\t<div class=\"wp-block-group wl-footer-column\">\n\t\t\t\t<!-- wp:heading {\"style\":{\"color\":{\"text\":\"#B5AE9E\"},\"typography\":{\"fontWeight\":\"600\",\"letterSpacing\":\"0.12em\",\"lineHeight\":\"1.5\",\"textTransform\":\"uppercase\"}},\"fontSize\":\"x-small\",\"fontFamily\":\"schibsted-grotesk\"} -->\n\t\t\t\t<h2 class=\"wp-block-heading has-text-color has-schibsted-grotesk-font-family has-x-small-font-size\" style=\"color:#B5AE9E;font-weight:600;letter-spacing:0.12em;line-height:1.5;text-transform:uppercase\">Elsewhere</h2>\n\t\t\t\t<!-- /wp:heading -->\n\n\t\t\t\t<!-- wp:group {\"className\":\"wl-footer-pages\",\"style\":{\"spacing\":{\"blockGap\":\"0\"}},\"layout\":{\"type\":\"default\"}} -->\n\t\t\t\t<div class=\"wp-block-group wl-footer-pages\">\n\t\t\t\t\t<!-- wp:page-list {\"className\":\"wl-footer-list\"} /-->\n\n\t\t\t\t\t<!-- wp:paragraph {\"className\":\"wl-footer-feed\",\"fontSize\":\"small\"} -->\n\t\t\t\t\t<p class=\"wl-footer-feed has-small-font-size\"><a href=\"http://localhost:8089/feed/\">RSS</a></p>\n\t\t\t\t\t<!-- /wp:paragraph -->\n\t\t\t\t</div>\n\t\t\t\t<!-- /wp:group -->\n\t\t\t</div>\n\t\t\t<!-- /wp:group -->\n\t\t</div>\n\t\t<!-- /wp:group -->\n\t</div>\n\t<!-- /wp:group -->\n\n\t<!-- wp:group {\"align\":\"wide\",\"style\":{\"spacing\":{\"padding\":{\"top\":\"var:preset|spacing|40\"}},\"border\":{\"top\":{\"color\":\"#3A352C\",\"width\":\"1px\"}}},\"layout\":{\"type\":\"flex\",\"flexWrap\":\"wrap\",\"justifyContent\":\"space-between\"}} -->\n\t<div class=\"wp-block-group alignwide\" style=\"border-top-color:#3A352C;border-top-width:1px;padding-top:var(--wp--preset--spacing--40)\">\n\t\t<!-- wp:paragraph {\"style\":{\"color\":{\"text\":\"#B5AE9E\"},\"typography\":{\"fontSize\":\"13px\"}}} -->\n\t\t<p class=\"has-text-color\" style=\"color:#B5AE9E;font-size:13px\">&copy;&nbsp;2026&nbsp;Wild Lemon Review</p>\n\t\t<!-- /wp:paragraph -->\n\n\t\t<!-- wp:paragraph {\"style\":{\"color\":{\"text\":\"#B5AE9E\"},\"typography\":{\"fontSize\":\"13px\"}}} -->\n\t\t<p class=\"has-text-color\" style=\"color:#B5AE9E;font-size:13px\">\n\t\t\tProudly powered by <a href=\"https://wordpress.org\" rel=\"nofollow\">WordPress</a>\t\t</p>\n\t\t<!-- /wp:paragraph -->\n\t</div>\n\t<!-- /wp:group -->\n</div>\n<!-- /wp:group -->\n"
