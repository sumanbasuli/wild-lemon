    {
        "name": "wild-lemon/editorial-introduction",
        "content": "<!-- wp:group {\"align\":\"wide\",\"className\":\"wl-pattern-intro\",\"layout\":{\"type\":\"default\"}} -->\n<div class=\"wp-block-group alignwide wl-pattern-intro\">\n\t<!-- wp:columns {\"verticalAlignment\":\"center\",\"className\":\"wl-intro-layout\"} -->\n\t<div class=\"wp-block-columns are-vertically-aligned-center wl-intro-layout\">\n\t\t<!-- wp:column {\"verticalAlignment\":\"center\"} -->\n\t\t<div class=\"wp-block-column is-vertically-aligned-center\">\n\t\t\t<!-- wp:paragraph {\"className\":\"wl-pattern-kicker\"} -->\n\t\t\t<p class=\"wl-pattern-kicker\">A slower kind of journal</p>\n\t\t\t<!-- /wp:paragraph -->\n\t\t\t<!-- wp:heading {\"className\":\"wl-pattern-intro-title\"} -->\n\t\t\t<h2 class=\"wp-block-heading wl-pattern-intro-title\">A life well noticed.</h2>\n\t\t\t<!-- /wp:heading -->\n\t\t\t<!-- wp:paragraph {\"className\":\"wl-pattern-intro-copy\"} -->\n\t\t\t<p class=\"wl-pattern-intro-copy\">A place for seasonal food, unhurried days, and the small discoveries that stay with us.</p>\n\t\t\t<!-- /wp:paragraph -->\n\t\t\t<!-- wp:paragraph {\"className\":\"wl-pattern-footnote\"} -->\n\t\t\t<p class=\"wl-pattern-footnote\">Food. Place. Everyday life.</p>\n\t\t\t<!-- /wp:paragraph -->\n\t\t</div>\n\t\t<!-- /wp:column -->\n\t\t<!-- wp:column {\"verticalAlignment\":\"center\"} -->\n\t\t<div class=\"wp-block-column is-vertically-aligned-center\">\n\t\t\t<!-- wp:image {\"aspectRatio\":\"4/3\",\"scale\":\"cover\",\"sizeSlug\":\"full\",\"linkDestination\":\"none\",\"className\":\"wl-intro-image\"} -->\n\t\t\t<figure class=\"wp-block-image size-full wl-intro-image\"><img src=\"http://localhost:8089/wp-content/themes/wild-lemon/assets/images/citrus-still-life.webp\" alt=\"Sunlit lemons and a leafy branch beside a ceramic bowl on linen.\" style=\"aspect-ratio:4/3;object-fit:cover\"/></figure>\n\t\t\t<!-- /wp:image -->\n\t\t</div>\n\t\t<!-- /wp:column -->\n\t</div>\n\t<!-- /wp:columns -->\n</div>\n<!-- /wp:group -->\n"
    },
    {
        "name": "wild-lemon/featured-quotation",
        "content": "<!-- wp:group {\"align\":\"wide\",\"className\":\"wl-pattern-quotation\",\"layout\":{\"type\":\"default\"}} -->\n<div class=\"wp-block-group alignwide wl-pattern-quotation\">\n\t<!-- wp:paragraph {\"className\":\"wl-pattern-kicker\"} -->\n\t<p class=\"wl-pattern-kicker\">A thought to keep</p>\n\t<!-- /wp:paragraph -->\n\t<!-- wp:quote {\"className\":\"wl-editorial-quote\"} -->\n\t<blockquote class=\"wp-block-quote wl-editorial-quote\">\n\t\t<!-- wp:paragraph -->\n\t\t<p>There is a whole world in the things we walk past every day.</p>\n\t\t<!-- /wp:paragraph -->\n\t\t<cite>From the journal</cite>\n\t</blockquote>\n\t<!-- /wp:quote -->\n</div>\n<!-- /wp:group -->\n"
