    {
        "name": "wild-lemon/photo-essay",
        "content": "<!-- wp:group {\"align\":\"wide\",\"className\":\"wl-pattern-photo-essay\",\"layout\":{\"type\":\"default\"}} -->\n<div class=\"wp-block-group alignwide wl-pattern-photo-essay\">\n\t<!-- wp:paragraph {\"className\":\"wl-pattern-kicker\"} -->\n\t<p class=\"wl-pattern-kicker\">A day in pictures</p>\n\t<!-- /wp:paragraph -->\n\t<!-- wp:heading {\"className\":\"wl-pattern-feature-title\"} -->\n\t<h2 class=\"wp-block-heading wl-pattern-feature-title\">Out in the world. Back to yourself.</h2>\n\t<!-- /wp:heading -->\n\t<!-- wp:paragraph {\"className\":\"wl-pattern-lede\"} -->\n\t<p class=\"wl-pattern-lede\">A walk without a destination. A few lines before the light goes. Two ways to pay attention to an ordinary day.</p>\n\t<!-- /wp:paragraph -->\n\t<!-- wp:columns {\"className\":\"wl-photo-layout\"} -->\n\t<div class=\"wp-block-columns wl-photo-layout\">\n\t\t<!-- wp:column {\"width\":\"66.667%\"} -->\n\t\t<div class=\"wp-block-column\" style=\"flex-basis:66.667%\">\n\t\t\t<!-- wp:image {\"aspectRatio\":\"3/2\",\"scale\":\"cover\",\"sizeSlug\":\"full\",\"linkDestination\":\"none\"} -->\n\t\t\t<figure class=\"wp-block-image size-full\"><img src=\"http://localhost:8089/wp-content/themes/wild-lemon/assets/images/garden-walk.webp\" alt=\"A stone path winds between herbs, terracotta pots, and an olive tree.\" style=\"aspect-ratio:3/2;object-fit:cover\"/><figcaption class=\"wp-element-caption\">01 \u2014 Take the path you have time for.</figcaption></figure>\n\t\t\t<!-- /wp:image -->\n\t\t</div>\n\t\t<!-- /wp:column -->\n\t\t<!-- wp:column {\"width\":\"33.333%\"} -->\n\t\t<div class=\"wp-block-column\" style=\"flex-basis:33.333%\">\n\t\t\t<!-- wp:image {\"aspectRatio\":\"3/4\",\"scale\":\"cover\",\"sizeSlug\":\"full\",\"linkDestination\":\"none\"} -->\n\t\t\t<figure class=\"wp-block-image size-full\"><img src=\"http://localhost:8089/wp-content/themes/wild-lemon/assets/images/quiet-notebook.webp\" alt=\"An open notebook and pencil beside a cup of tea and an olive sprig.\" style=\"aspect-ratio:3/4;object-fit:cover\"/><figcaption class=\"wp-element-caption\">02 \u2014 Bring a little of it home.</figcaption></figure>\n\t\t\t<!-- /wp:image -->\n\t\t</div>\n\t\t<!-- /wp:column -->\n\t</div>\n\t<!-- /wp:columns -->\n</div>\n<!-- /wp:group -->\n"
