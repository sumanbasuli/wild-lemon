    "debug": true,
    "debugLog": true,
    "debugDisplay": false,
    "developmentMode": "theme",
    "postContentSpacingSupport": {
        "blockGap": true,
        "padding": true,
        "__experimentalDefaultControls": {
            "margin": false,
            "padding": false
        }
    }
}