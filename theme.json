{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": true,
		"layout": {
			"contentSize": "680px",
			"wideSize": "1120px"
		},
		"color": {
			"defaultDuotone": false,
			"defaultGradients": false,
			"defaultPalette": false,
			"palette": [
				{
					"color": "#FBF9F3",
					"name": "Base",
					"slug": "base"
				},
				{
					"color": "#221E18",
					"name": "Contrast",
					"slug": "contrast"
				},
				{
					"color": "#57503F",
					"name": "Deep Stone",
					"slug": "contrast-2"
				},
				{
					"color": "#EDC93B",
					"name": "Lemon",
					"slug": "accent"
				},
				{
					"color": "#F6ECC2",
					"name": "Lemon Tint",
					"slug": "accent-2"
				},
				{
					"color": "#695F01",
					"name": "Olive",
					"slug": "accent-3"
				},
				{
					"color": "#6F6759",
					"name": "Stone",
					"slug": "muted"
				},
				{
					"color": "#726B5C",
					"name": "Stone Light",
					"slug": "muted-2"
				},
				{
					"color": "#E6E0D2",
					"name": "Line",
					"slug": "line"
				}
			]
		},
		"spacing": {
			"defaultSpacingSizes": false,
			"spacingSizes": [
				{
					"name": "Tiny",
					"size": "12px",
					"slug": "20"
				},
				{
					"name": "X-Small",
					"size": "16px",
					"slug": "30"
				},
				{
					"name": "Small",
					"size": "24px",
					"slug": "40"
				},
				{
					"name": "Medium",
					"size": "clamp(1.5rem, 4vw, 2.25rem)",
					"slug": "50"
				},
				{
					"name": "Large",
					"size": "clamp(1.5rem, 5vw, 3.5rem)",
					"slug": "60"
				},
				{
					"name": "X-Large",
					"size": "clamp(2.5rem, 6vw, 4.5rem)",
					"slug": "70"
				},
				{
					"name": "XX-Large",
					"size": "clamp(3rem, 8vw, 6rem)",
					"slug": "80"
				}
			],
			"units": [ "%", "px", "em", "rem", "vh", "vw" ]
		},
		"typography": {
			"defaultFontSizes": false,
			"fluid": true,
			"fontFamilies": [
				{
					"fontFace": [
						{
							"fontFamily": "Newsreader",
							"fontStyle": "normal",
							"fontWeight": "400 700",
							"src": [ "file:./assets/fonts/newsreader-normal.woff2" ]
						},
						{
							"fontFamily": "Newsreader",
							"fontStyle": "italic",
							"fontWeight": "400 700",
							"src": [ "file:./assets/fonts/newsreader-italic.woff2" ]
						}
					],
					"fontFamily": "Newsreader, 'Iowan Old Style', Georgia, serif",
					"name": "Newsreader",
					"slug": "newsreader"
				},
				{
					"fontFace": [
						{
							"fontFamily": "Schibsted Grotesk",
							"fontStyle": "normal",
							"fontWeight": "400 700",
							"src": [ "file:./assets/fonts/schibsted-grotesk-normal.woff2" ]
						},
						{
							"fontFamily": "Schibsted Grotesk",
							"fontStyle": "italic",
							"fontWeight": "400 700",
							"src": [ "file:./assets/fonts/schibsted-grotesk-italic.woff2" ]
						}
					],
					"fontFamily": "'Schibsted Grotesk', 'Helvetica Neue', Helvetica, Arial, sans-serif",
					"name": "Schibsted Grotesk",
					"slug": "schibsted-grotesk"
				}
			],
			"fontSizes": [
				{
					"fluid": false,
					"name": "X-Small",
					"size": "12px",
					"slug": "x-small"
				},
				{
					"fluid": false,
					"name": "Small",
					"size": "14px",
					"slug": "small"
				},
				{
					"fluid": false,
					"name": "Medium",
					"size": "17px",
					"slug": "medium"
				},
				{
					"fluid": {
						"max": "30px",
						"min": "26px"
					},
					"name": "Large",
					"size": "30px",
					"slug": "large"
				},
				{
					"fluid": {
						"max": "44px",
						"min": "34px"
					},
					"name": "X-Large",
					"size": "44px",
					"slug": "x-large"
				},
				{
					"fluid": {
						"max": "64px",
						"min": "42px"
					},
					"name": "XX-Large",
					"size": "64px",
					"slug": "xx-large"
				}
			]
		}
	},
	"styles": {
		"color": {
			"background": "var:preset|color|base",
			"text": "var:preset|color|contrast"
		},
		"elements": {
			"button": {
				"border": {
					"radius": "99px"
				},
				"color": {
					"background": "var:preset|color|contrast",
					"text": "var:preset|color|base"
				},
				"typography": {
					"fontFamily": "var:preset|font-family|schibsted-grotesk",
					"fontSize": "var:preset|font-size|small",
					"fontWeight": "600"
				},
				":hover": {
					"color": {
						"background": "var:preset|color|contrast-2",
						"text": "var:preset|color|base"
					}
				}
			},
			"caption": {
				"color": {
					"text": "var:preset|color|muted-2"
				},
				"typography": {
					"fontFamily": "var:preset|font-family|schibsted-grotesk",
					"fontSize": "13px"
				}
			},
			"h1": {
				"typography": {
					"fontSize": "var:preset|font-size|xx-large",
					"letterSpacing": "-0.015em",
					"lineHeight": "1.08"
				}
			},
			"h2": {
				"typography": {
					"fontSize": "var:preset|font-size|large",
					"lineHeight": "1.2"
				}
			},
			"h3": {
				"typography": {
					"fontSize": "24px",
					"lineHeight": "1.25"
				}
			},
			"h4": {
				"typography": {
					"fontSize": "20px",
					"lineHeight": "1.3"
				}
			},
			"h5": {
				"typography": {
					"fontSize": "var:preset|font-size|medium",
					"lineHeight": "1.4"
				}
			},
			"h6": {
				"typography": {
					"fontSize": "var:preset|font-size|small",
					"letterSpacing": "0.1em",
					"lineHeight": "1.4",
					"textTransform": "uppercase"
				}
			},
			"heading": {
				"typography": {
					"fontFamily": "var:preset|font-family|newsreader",
					"fontWeight": "500"
				}
			},
			"link": {
				"color": {
					"text": "var:preset|color|accent-3"
				},
				"typography": {
					"textDecoration": "underline"
				},
				":hover": {
					"color": {
						"text": "var:preset|color|contrast"
					}
				}
			}
		},
		"spacing": {
			"blockGap": "1.5rem",
			"padding": {
				"bottom": "0px",
				"left": "var:preset|spacing|60",
				"right": "var:preset|spacing|60",
				"top": "0px"
			}
		},
		"typography": {
			"fontFamily": "var:preset|font-family|schibsted-grotesk",
			"fontSize": "var:preset|font-size|medium",
			"lineHeight": "1.55"
		},
		"blocks": {
			"core/code": {
				"border": {
					"radius": "8px"
				},
				"color": {
					"background": "#DFDBD0",
					"text": "var:preset|color|contrast"
				},
				"spacing": {
					"padding": {
						"bottom": "var:preset|spacing|40",
						"left": "var:preset|spacing|40",
						"right": "var:preset|spacing|40",
						"top": "var:preset|spacing|40"
					}
				},
				"typography": {
					"fontSize": "14px"
				}
			},
			"core/navigation": {
				"elements": {
					"link": {
						"typography": {
							"textDecoration": "none"
						},
						":hover": {
							"color": {
								"text": "var:preset|color|accent-3"
							},
							"typography": {
								"textDecoration": "none"
							}
						}
					}
				},
				"typography": {
					"fontSize": "15px",
					"fontWeight": "500"
				}
			},
			"core/post-content": {
				"typography": {
					"fontFamily": "var:preset|font-family|newsreader",
					"fontSize": "19px",
					"lineHeight": "1.7"
				}
			},
			"core/pullquote": {
				"border": {
					"bottom": {
						"color": "var:preset|color|line",
						"style": "solid",
						"width": "1px"
					},
					"top": {
						"color": "var:preset|color|contrast",
						"style": "solid",
						"width": "3px"
					}
				},
				"spacing": {
					"padding": {
						"bottom": "var:preset|spacing|50",
						"left": "8px",
						"right": "8px",
						"top": "var:preset|spacing|50"
					}
				},
				"typography": {
					"fontFamily": "var:preset|font-family|newsreader",
					"fontSize": "29px",
					"fontStyle": "italic",
					"fontWeight": "500",
					"lineHeight": "1.35"
				}
			},
			"core/quote": {
				"border": {
					"left": {
						"color": "var:preset|color|accent",
						"style": "solid",
						"width": "3px"
					}
				},
				"spacing": {
					"padding": {
						"left": "var:preset|spacing|40"
					}
				},
				"typography": {
					"fontFamily": "var:preset|font-family|newsreader",
					"fontStyle": "italic"
				}
			},
			"core/search": {
				"typography": {
					"fontFamily": "var:preset|font-family|schibsted-grotesk",
					"fontSize": "var:preset|font-size|small"
				}
			},
			"core/separator": {
				"color": {
					"text": "var:preset|color|line"
				}
			},
			"core/site-title": {
				"elements": {
					"link": {
						"color": {
							"text": "var:preset|color|contrast"
						},
						"typography": {
							"textDecoration": "none"
						},
						":hover": {
							"color": {
								"text": "var:preset|color|contrast"
							},
							"typography": {
								"textDecoration": "none"
							}
						}
					}
				},
				"typography": {
					"fontFamily": "var:preset|font-family|newsreader",
					"fontSize": "27px",
					"fontWeight": "600",
					"letterSpacing": "-0.01em"
				}
			}
		}
	},
	"templateParts": [
		{
			"area": "header",
			"name": "header",
			"title": "Header"
		},
		{
			"area": "footer",
			"name": "footer",
			"title": "Footer"
		},
		{
			"area": "footer",
			"name": "footer-compact",
			"title": "Footer Compact"
		}
	]
}
